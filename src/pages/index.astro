---
import About from "../components/About.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import { withBase } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <Navbar active="home" />
  <main>
    <section class="hero is-fullheight-with-navbar" id="hero">
      <div class="hero-body">
        <div class="container hero-content" data-reveal>
          <p class="hero-eyebrow">AI research & engineering</p>
          <h1 class="hero-title">
            Building intelligent systems.<br />
            <span>Making them understandable.</span>
          </h1>
          <p class="hero-summary">
            Notes on generative AI, computer vision, and applied research.
          </p>
          <div class="hero-actions">
            <a href={withBase("/blog")} class="button button-primary">Explore writing <span aria-hidden="true">↗</span></a>
            <a href={withBase("/#about")} class="button button-secondary">About me</a>
          </div>
        </div>
      </div>
    </section>
    <About />
  </main>
  <Footer />
</BaseLayout>
