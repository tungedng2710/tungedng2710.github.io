---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import Icon from "../components/ResumeIcon.astro";
import { site, withBase } from "../config";
import {
  experience,
  publications,
  projects,
  education,
  toolkits,
  credentials,
  service,
} from "../data/resume";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/resume.scss";

const resumeUrl = withBase("/resume/NguyenTung_AI_Resume.pdf");
const now = new Date();
const yearsInAI = Math.max(0, now.getFullYear() - 2020);
const careerYears = Array.from(
  { length: now.getFullYear() - 2020 + 1 },
  (_, index) => 2020 + index,
);
const chartStart = new Date("2020-01-01T00:00:00Z").getTime();
const chartEnd = Date.UTC(now.getFullYear() + 1, 0, 1);
const chartPosition = (date: string) =>
  ((new Date(date).getTime() - chartStart) / (chartEnd - chartStart)) * 100;
const navigation = [
  { id: "overview", label: "Overview", icon: "grid", count: null },
  {
    id: "experience",
    label: "Experience",
    icon: "briefcase",
    count: experience.length,
  },
  { id: "projects", label: "Projects", icon: "layers", count: projects.length },
  {
    id: "research",
    label: "Research",
    icon: "book",
    count: publications.length,
  },
  {
    id: "education",
    label: "Education",
    icon: "education",
    count: education.length,
  },
  { id: "toolkit", label: "Skills & toolkit", icon: "code", count: null },
];
const projectTags = [
  ["Generative AI", "LLMs", "RAG", "Healthcare"],
  ["Computer Vision", "Detection", "Tracking", "OCR"],
  ["Computer Vision", "eKYC", "OCR", "Document AI"],
];
const projectSummaries = [
  "Vietnamese medical knowledge, made accessible through conversation.",
  "From raw traffic footage to structured, actionable insight.",
  "Turning identity documents into reliable, structured information.",
];
const projectCategories = [
  "Generative AI",
  "Computer Vision",
  "Computer Vision",
];
const careerBars = [
  { name: "Techainer", from: "2020-08-01", to: "2020-10-01", index: 4 },
  { name: "PIXTA", from: "2020-12-01", to: "2021-06-01", index: 3 },
  { name: "Grooo", from: "2021-10-01", to: "2022-03-01", index: 2 },
  {
    name: "Viettel Solutions",
    from: "2022-03-01",
    to: now.toISOString(),
    index: 0,
  },
  { name: "WorldQuant", from: "2025-03-01", to: now.toISOString(), index: 1 },
].map((role) => ({
  ...role,
  start: chartPosition(role.from),
  width: chartPosition(role.to) - chartPosition(role.from),
}));
---

<BaseLayout
  title="Resume · Career Dashboard"
  description="Explore Tung Nguyen’s experience, research, projects, and toolkit in an interactive career dashboard. AI engineering, computer vision, and generative AI."
  bodyClass="resume-body"
>
  <Navbar />
  <main class="career-dashboard" id="career-dashboard">
    <aside class="dashboard-sidebar" aria-label="Resume navigation">
      <a class="workspace-label" href={withBase("/resume")}>
        <span class="workspace-mark">
          <Icon name="grid" size={17} />
        </span>{" "}
        Career workspace <span class="workspace-version">01</span>
      </a>
      <div class="sidebar-profile">
        <div class="profile-avatar">
          <img
            src={withBase(site.author.image)}
            alt="Tung Nguyen"
            width="76"
            height="76"
          />
          <span class="avatar-dot" aria-hidden="true"></span>
        </div>
        <h2>
          Tung Nguyen<span>.</span>
        </h2>
        <p>AI Engineer & Researcher</p>
        <span class="location">
          <Icon name="pin" size={13} /> Hanoi, Vietnam
        </span>
      </div>
      <p class="sidebar-label">EXPLORE MY RESUME</p>
      <nav class="dashboard-nav" aria-label="Resume sections">
        {navigation.map((item) => (
          <a
            href={`#${item.id}`}
            id={`nav-${item.id}`}
            data-section-link={item.id}
          >
            <Icon name={item.icon} size={18} />
            <span>{item.label}</span>
            {item.count !== null && (
              <span class="nav-count">
                {String(item.count).padStart(2, "0")}
              </span>
            )}
          </a>
        ))}
      </nav>
      <div class="sidebar-bottom">
        <div class="sidebar-note">
          <span class="small-orbit" aria-hidden="true">
            ✳
          </span>
          <p>
            From research
            <br />
            to the real world.
          </p>
          <span>Building AI that makes a difference.</span>
        </div>
        <a class="sidebar-contact" href={`mailto:${site.email}`}>
          <Icon name="mail" size={16} /> Let’s connect{" "}
          <Icon name="external" size={13} />
        </a>
        <div class="sidebar-socials">
          <a
            href={site.social.github}
            target="_blank"
            rel="noreferrer"
            aria-label="GitHub"
          >
            <Icon name="github" size={17} />
          </a>
          <a
            href={site.social.linkedin}
            target="_blank"
            rel="noreferrer"
            aria-label="LinkedIn"
          >
            <Icon name="linkedin" size={17} />
          </a>
          <a href="tel:+84969200308">+84 969 200 308</a>
        </div>
      </div>
    </aside>

    <div class="dashboard-content">
      <div class="dashboard-toolbar">
        <div class="breadcrumb">
          Resume <Icon name="chevron" size={12} />
          <span id="current-section">Overview</span>
        </div>
        <div class="toolbar-actions">
          <label class="resume-search">
            <Icon name="search" size={16} />
            <input
              id="resume-search"
              type="search"
              placeholder="Search my resume…"
              aria-label="Search experience, projects, research, education, and skills"
              autocomplete="off"
            />
            <kbd aria-hidden="true">/</kbd>
          </label>
          <a
            class="pdf-action"
            href={resumeUrl}
            download="NguyenTung_AI_Resume.pdf"
          >
            <Icon name="download" size={16} />
            <span>Download CV</span>
          </a>
        </div>
      </div>

      <div class="dashboard-inner">
        <div class="search-feedback" id="search-feedback" hidden>
          <p role="status" id="search-status"></p>
          <button type="button" id="clear-search">
            Clear search <span aria-hidden="true">×</span>
          </button>
        </div>

        <section
          class="dashboard-panel"
          id="overview"
          aria-labelledby="heading-overview"
          data-panel="overview"
        >
          <header class="dashboard-heading">
            <div>
              <p class="eyebrow">
                <span></span> THE PERSON BEHIND THE WORK
              </p>
              <h1 id="heading-overview">
                A little context.
                <br />A lot of <em>possibility.</em>
              </h1>
              <p class="heading-description">
                I’m Tung, an AI engineer turning research into things that work.
                <br class="desktop-break" /> Here’s a closer look at my journey
                so far.
              </p>
            </div>
            <div class="hero-orbit" aria-hidden="true">
              <span class="orbit-label">RESEARCH × ENGINEERING</span>
              <svg viewBox="0 0 160 160" fill="none">
                <circle cx="80" cy="80" r="58" />
                <ellipse
                  cx="80"
                  cy="80"
                  rx="25"
                  ry="58"
                  transform="rotate(45 80 80)"
                />
                <ellipse
                  cx="80"
                  cy="80"
                  rx="25"
                  ry="58"
                  transform="rotate(-45 80 80)"
                />
                <path d="M22 80h116M80 22v116" />
                <circle class="orbit-center" cx="80" cy="80" r="8" />
                <circle class="orbit-planet" cx="122" cy="40" r="6" />
              </svg>
              <span class="orbit-coordinate">21.0285° N · 105.8542° E</span>
            </div>
          </header>

          <div class="metric-grid">
            <a class="metric-card" href="#experience" data-go="experience">
              <div class="metric-top">
                <span>IN THE FIELD</span>
                <Icon name="briefcase" size={17} />
              </div>
              <p class="metric-value">
                {yearsInAI}
                <span> years</span>
              </p>
              <p class="metric-caption">
                Building in AI since 2020 <Icon name="arrow" size={15} />
              </p>
            </a>
            <a class="metric-card" href="#projects" data-go="projects">
              <div class="metric-top">
                <span>SELECTED WORK</span>
                <Icon name="layers" size={17} />
              </div>
              <p class="metric-value">
                0{projects.length}
                <span> projects</span>
              </p>
              <p class="metric-caption">
                Ideas put into practice <Icon name="arrow" size={15} />
              </p>
            </a>
            <a class="metric-card" href="#research" data-go="research">
              <div class="metric-top">
                <span>RESEARCH OUTPUT</span>
                <Icon name="book" size={17} />
              </div>
              <p class="metric-value">
                0{publications.length}
                <span> publications</span>
              </p>
              <p class="metric-caption">
                Contributing to the conversation <Icon name="arrow" size={15} />
              </p>
            </a>
            <a
              class="metric-card metric-highlight"
              href="#education"
              data-go="education"
            >
              <div class="metric-top">
                <span>ACADEMIC FOUNDATION</span>
                <Icon name="education" size={17} />
              </div>
              <p class="metric-value">
                3.81<span> / 4.00</span>
              </p>
              <p class="metric-caption">
                MSc · Applied Mathematics <Icon name="arrow" size={15} />
              </p>
            </a>
          </div>

          <div class="overview-grid">
            <article class="dashboard-card current-focus">
              <div class="card-heading">
                <h2>
                  <span class="status-dot"></span> Where I am now
                </h2>
                <span class="subtle-tag">FULL-TIME</span>
              </div>
              <div class="current-role">
                <span class="company-monogram">
                  V<span>↗</span>
                </span>
                <div>
                  <h3>AI Engineer</h3>
                  <p>Viettel Solutions Corporation</p>
                </div>
                <span class="current-since">2022 — PRESENT</span>
              </div>
              <p class="focus-description">
                Bringing computer vision and generative AI into production. My
                work spans intelligent document processing, vision-language
                models, traffic analysis, and speech enhancement.
              </p>
              <div class="tag-list">
                <span>Document AI</span>
                <span>Computer Vision</span>
                <span>Generative AI</span>
              </div>
              <div class="card-bottom">
                <span>
                  <Icon name="pin" size={13} /> Hanoi, Vietnam
                </span>
                <a href="#experience" data-go="experience" data-role="0">
                  Explore my experience <Icon name="arrow" size={15} />
                </a>
              </div>
            </article>
            <article class="dashboard-card interests-card">
              <div class="card-heading">
                <h2>What I think about</h2>
                <Icon name="spark" size={18} />
              </div>
              <p class="card-description">The areas that keep me curious.</p>
              <div class="interest-links">
                {[
                  {
                    title: "Computer Vision",
                    note: "Making sense of the visual world",
                    icon: "grid",
                  },
                  {
                    title: "Generative AI",
                    note: "Language, vision & new possibilities",
                    icon: "spark",
                  },
                  {
                    title: "Research",
                    note: "Applied mathematics & learning",
                    icon: "code",
                  },
                ].map((item) => (
                  <a
                    href="#toolkit"
                    data-go="toolkit"
                    data-toolkit={item.title}
                  >
                    <span class="interest-icon">
                      <Icon name={item.icon} size={19} />
                    </span>
                    <span>
                      <strong>
                        {item.title === "Research"
                          ? "Applied Mathematics"
                          : item.title}
                      </strong>
                      <small>{item.note}</small>
                    </span>
                    <Icon name="chevron" size={14} />
                  </a>
                ))}
              </div>
            </article>
          </div>

          <article class="dashboard-card career-map">
            <div class="card-heading">
              <div>
                <h2>A journey in the making</h2>
                <p class="card-description">
                  From my first experiments to production systems.
                </p>
              </div>
              <a class="text-link" href="#experience" data-go="experience">
                View timeline <Icon name="arrow" size={15} />
              </a>
            </div>
            <div
              class="career-chart"
              style={`--chart-years: ${careerYears.length};`}
            >
              <div class="chart-axis">
                {careerYears.map((year) => (
                  <span>{year}</span>
                ))}
              </div>
              <div class="chart-tracks">
                {careerBars.map((bar) => (
                  <a
                    class:list={[
                      "career-track",
                      { "track-current": bar.index < 2 },
                    ]}
                    href="#experience"
                    data-go="experience"
                    data-role={bar.index}
                    aria-label={`${experience[bar.index].role} at ${experience[bar.index].organization}, ${experience[bar.index].period}`}
                  >
                    <span class="track-label">{bar.name}</span>
                    <span class="track-lane">
                      <span
                        class="track-bar"
                        style={`--bar-start: ${bar.start}%; --bar-width: ${bar.width}%;`}
                      >
                        <span>{bar.index < 2 ? "Present" : ""}</span>
                      </span>
                    </span>
                    <Icon name="external" size={12} />
                  </a>
                ))}
              </div>
            </div>
            <div class="chart-footnote">
              <span>
                <i></i> Current role
              </span>
              <span>
                <i></i> Previous experience
              </span>
              <p>
                Select a role to explore <Icon name="arrow" size={13} />
              </p>
            </div>
          </article>

          <div class="overview-bottom">
            <article class="dashboard-card research-preview">
              <div class="card-heading">
                <h2>On the research side</h2>
                <span class="subtle-tag">LATEST PUBLICATION</span>
              </div>
              <p class="publication-eyebrow">EAI INISCOM · 2025</p>
              <h3>{publications[0].title}</h3>
              <a class="text-link" href="#research" data-go="research">
                Explore publications <Icon name="arrow" size={15} />
              </a>
            </article>
            <article class="contact-card">
              <Icon name="spark" size={25} />
              <h2>
                Good work starts
                <br />
                with a conversation.
              </h2>
              <div>
                <a href={`mailto:${site.email}`}>
                  Say hello <Icon name="external" size={15} />
                </a>
                <button
                  type="button"
                  class="copy-email"
                  data-email={site.email}
                  aria-label="Copy email address"
                  title="Copy email address"
                >
                  <Icon name="copy" size={16} />
                </button>
              </div>
              <span id="copy-status" role="status" aria-live="polite"></span>
            </article>
          </div>
        </section>

        <section
          class="dashboard-panel"
          id="experience"
          aria-labelledby="heading-experience"
          data-panel="experience"
        >
          <header class="dashboard-section-heading">
            <p class="eyebrow">THE JOURNEY SO FAR</p>
            <h2 id="heading-experience">
              Research & <em>experience.</em>
            </h2>
            <p>
              Learning by building. From early computer vision experiments to AI
              in production.
            </p>
          </header>
          <div
            class="panel-tools"
            data-filter-group="experience"
            aria-label="Filter experience"
          >
            <button type="button" data-filter="All" aria-pressed="true">
              All roles <span>{experience.length}</span>
            </button>
            <button type="button" data-filter="Full-time" aria-pressed="false">
              Full-time
            </button>
            <button type="button" data-filter="Part-time" aria-pressed="false">
              Part-time
            </button>
            <span class="tools-note">Select a role to see the details</span>
          </div>
          <div class="experience-timeline">
            {experience.map((item, index) => (
              <article
                class="experience-record"
                data-record
                data-category={item.type}
              >
                <div class="timeline-marker" aria-hidden="true">
                  <span></span>
                </div>
                <div class="experience-date">
                  <span>{item.period}</span>
                  <small>{item.location}</small>
                  {index < 2 && (
                    <span class="present-badge">
                      <i></i> Current
                    </span>
                  )}
                </div>
                <details
                  class="dashboard-card experience-detail"
                  id={`role-${index}`}
                  open={index === 0}
                >
                  <summary>
                    <div>
                      <span class="subtle-tag">{item.type}</span>
                      <h3>{item.role}</h3>
                      <p>{item.organization}</p>
                    </div>
                    <span class="expand-icon">
                      <Icon name="chevron" size={18} />
                    </span>
                  </summary>
                  <div class="experience-highlights">
                    <p class="detail-label">WORK & CONTRIBUTIONS</p>
                    <ul>
                      {item.highlights.map((highlight) => (
                        <li>{highlight}</li>
                      ))}
                    </ul>
                  </div>
                </details>
              </article>
            ))}
          </div>
        </section>

        <section
          class="dashboard-panel"
          id="projects"
          aria-labelledby="heading-projects"
          data-panel="projects"
        >
          <header class="dashboard-section-heading">
            <p class="eyebrow">RESEARCH, MEET REALITY</p>
            <h2 id="heading-projects">
              Ideas in <em>practice.</em>
            </h2>
            <p>
              A selection of applied AI projects. Explore the problems,
              approaches, and systems behind the work.
            </p>
          </header>
          <div
            class="panel-tools"
            data-filter-group="projects"
            aria-label="Filter projects"
          >
            {["All", "Computer Vision", "Generative AI"].map((category) => (
              <button
                type="button"
                data-filter={category}
                aria-pressed={category === "All"}
              >
                {category === "All" ? "All projects" : category}
              </button>
            ))}
          </div>
          <div class="project-cards">
            {projects.map((project, index) => (
              <article
                class="dashboard-card project-record"
                data-record
                data-category={projectCategories[index]}
              >
                <div
                  class:list={["project-art", `project-art-${index}`]}
                  aria-hidden="true"
                >
                  <span class="project-art-label">
                    APPLIED AI / 0{index + 1}
                  </span>
                  {index === 0 ? (
                    <div class="conversation-art">
                      <span>
                        <i></i>
                        <i></i>
                        <i></i>
                      </span>
                      <span>
                        <i></i>
                        <i></i>
                      </span>
                      <span>
                        <Icon name="spark" size={20} /> dMOM
                      </span>
                    </div>
                  ) : index === 1 ? (
                    <div class="traffic-art">
                      <span class="road-line"></span>
                      <span class="road-line"></span>
                      <span class="detection-box">
                        VEHICLE <i></i>
                      </span>
                      <span class="detection-box">
                        OCR <i></i>
                      </span>
                    </div>
                  ) : (
                    <div class="document-art">
                      <span class="document-avatar"></span>
                      <span class="document-line"></span>
                      <span class="document-line"></span>
                      <span class="document-line"></span>
                      <span class="document-scan"></span>
                      <span class="document-check">
                        <Icon name="check" size={15} />
                      </span>
                    </div>
                  )}
                </div>
                <div class="project-copy">
                  <p class="publication-eyebrow">{projectCategories[index]}</p>
                  <h3>{project.title}</h3>
                  <p>{projectSummaries[index]}</p>
                  <div class="tag-list">
                    {projectTags[index].slice(1).map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                  <details class="project-description">
                    <summary>
                      Explore project <Icon name="chevron" size={15} />
                    </summary>
                    <p>{project.description}</p>
                  </details>
                  {project.href && (
                    <a
                      class="text-link repository-link"
                      href={project.href}
                      target="_blank"
                      rel="noreferrer"
                    >
                      <Icon name="github" size={15} /> View repository{" "}
                      <Icon name="external" size={13} />
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>

        <section
          class="dashboard-panel"
          id="research"
          aria-labelledby="heading-research"
          data-panel="research"
        >
          <header class="dashboard-section-heading">
            <p class="eyebrow">QUESTIONS WORTH EXPLORING</p>
            <h2 id="heading-research">
              A curious <em>mind.</em>
            </h2>
            <p>
              Selected publications, academic service, and contributions to the
              research community.
            </p>
          </header>
          <div class="section-caption">
            <h3>Selected publications</h3>
            <span>0{publications.length} PAPERS</span>
          </div>
          <div class="publication-cards">
            {publications.map((publication, index) => (
              <article class="dashboard-card publication-record" data-record>
                <span class="record-number">0{index + 1}</span>
                <div>
                  <p class="publication-eyebrow">{publication.venue}</p>
                  <h3>{publication.title}</h3>
                  {publication.href ? (
                    <a
                      class="text-link"
                      href={publication.href}
                      target="_blank"
                      rel="noreferrer"
                    >
                      Read publication <Icon name="external" size={13} />
                    </a>
                  ) : (
                    <span class="publication-note">
                      Conference contribution
                    </span>
                  )}
                </div>
                <Icon name="book" size={23} />
              </article>
            ))}
          </div>
          <div class="section-caption">
            <h3>Academic service</h3>
            <span>SHARING WHAT I LEARN</span>
          </div>
          <div class="service-grid">
            {service.map((item) => (
              <article class="dashboard-card service-record" data-record>
                <span class="publication-eyebrow">{item.period}</span>
                <h3>{item.role}</h3>
                <p>{item.organization}</p>
              </article>
            ))}
          </div>
        </section>

        <section
          class="dashboard-panel"
          id="education"
          aria-labelledby="heading-education"
          data-panel="education"
        >
          <header class="dashboard-section-heading">
            <p class="eyebrow">THE FOUNDATIONS</p>
            <h2 id="heading-education">
              Always <em>learning.</em>
            </h2>
            <p>
              A background in applied mathematics, a habit of asking questions,
              and a commitment to keep growing.
            </p>
          </header>
          <div class="education-cards">
            {education.map((item, index) => (
              <article class="dashboard-card education-record" data-record>
                <div class="education-icon">
                  <Icon name="education" size={26} />
                </div>
                <div>
                  <p class="publication-eyebrow">{item.period}</p>
                  <h3>{item.degree}</h3>
                  {item.field && <p class="degree-field">{item.field}</p>}
                  <p>{item.institution}</p>
                  {item.result && <span class="subtle-tag">{item.result}</span>}
                </div>
                {item.cpa && (
                  <div class="cpa">
                    <strong>{item.cpa}</strong>
                    <span>/ {item.maximum} CPA</span>
                  </div>
                )}
                <span class="record-number">0{index + 1}</span>
              </article>
            ))}
          </div>
          <div class="section-caption">
            <h3>Credentials</h3>
            <span>CONTINUING EDUCATION</span>
          </div>
          <div class="credential-cards">
            {credentials.map((item) => (
              <article class="dashboard-card credential-record" data-record>
                <Icon name="check" size={18} />
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.issuer}</p>
                </div>
                <time>{item.date}</time>
              </article>
            ))}
          </div>
          <div class="section-caption">
            <h3>Distinctions</h3>
            <span>A FEW MILESTONES</span>
          </div>
          <div class="service-grid">
            <article class="dashboard-card service-record" data-record>
              <p class="publication-eyebrow">2025</p>
              <h3>Tuổi trẻ sáng tạo toàn quốc</h3>
              <p>Ho Chi Minh Communist Youth Union</p>
            </article>
            <article class="dashboard-card service-record" data-record>
              <p class="publication-eyebrow">2020 · 2021</p>
              <h3>Academic Scholarship</h3>
              <p>Business partners of HUST</p>
            </article>
          </div>
        </section>

        <section
          class="dashboard-panel"
          id="toolkit"
          aria-labelledby="heading-toolkit"
          data-panel="toolkit"
        >
          <header class="dashboard-section-heading">
            <p class="eyebrow">HOW THE WORK GETS DONE</p>
            <h2 id="heading-toolkit">
              The working <em>toolkit.</em>
            </h2>
            <p>
              Methods, languages, and tools I use to move from a research
              question to a working system.
            </p>
          </header>
          <div
            class="panel-tools"
            data-filter-group="toolkit"
            aria-label="Filter skills"
          >
            {[
              "All",
              "Computer Vision",
              "Generative AI",
              "Engineering",
              "Research",
            ].map((category) => (
              <button
                type="button"
                data-filter={category}
                aria-pressed={category === "All"}
              >
                {category === "All" ? "All skills" : category}
              </button>
            ))}
          </div>
          <div class="toolkit-cards">
            {toolkits.map((toolkit) => (
              <article
                class="dashboard-card toolkit-record"
                data-record
                data-category={toolkit.category}
              >
                <span class="toolkit-icon">
                  <Icon name={toolkit.icon} size={22} />
                </span>
                <p class="publication-eyebrow">{toolkit.category}</p>
                <h3>{toolkit.title}</h3>
                <div class="tag-list">
                  {toolkit.items.map((item) => (
                    <span>{item}</span>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </section>

        <div class="empty-search" id="empty-search" hidden>
          <Icon name="search" size={30} />
          <h2>No matches yet.</h2>
          <p>Try a skill, company, project, or research topic.</p>
          <button type="button" data-reset-search>
            Show the full resume <Icon name="arrow" size={16} />
          </button>
        </div>
        <footer class="dashboard-footer">
          <span>A work in progress. Always.</span>
          <a href={resumeUrl} target="_blank" rel="noreferrer">
            Prefer the document? View PDF <Icon name="external" size={12} />
          </a>
        </footer>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import "../scripts/resume";
</script>
