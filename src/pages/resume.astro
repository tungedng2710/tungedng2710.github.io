---
import Navbar from "../components/Navbar.astro";
import { withBase } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";

const resumeUrl = withBase("/resume/NguyenTung_AI_Resume.pdf");
---

<BaseLayout
  title="Resume"
  description="The curriculum vitae of Tung Nguyen, AI researcher and engineer."
>
  <Navbar />
  <main class="resume-page">
    <section class="container resume-shell" aria-labelledby="resume-title">
      <header class="resume-header" data-reveal>
        <div>
          <p class="resume-kicker">Curriculum vitae</p>
          <h1 id="resume-title">Experience, <em>in detail.</em></h1>
          <p class="resume-summary">
            Education, research, and engineering work across applied mathematics,
            computer vision, and generative AI.
          </p>
        </div>

        <div class="resume-actions">
          <a class="resume-open" href={resumeUrl} target="_blank" rel="noreferrer">
            Open PDF <span aria-hidden="true">↗</span>
          </a>
          <a
            class="button button-primary resume-download"
            href={resumeUrl}
            download="NguyenTung_AI_Resume.pdf"
          >
            Download CV <span aria-hidden="true">↓</span>
          </a>
        </div>
      </header>

      <div class="resume-viewer" data-reveal style="--reveal-delay: 100ms;">
        <object
          data={resumeUrl}
          type="application/pdf"
          aria-label="Tung Nguyen's curriculum vitae"
        >
          <div class="resume-fallback">
            <p>Your browser cannot display the PDF inline.</p>
            <a href={resumeUrl} target="_blank" rel="noreferrer">Open the CV</a>
            <span aria-hidden="true"> or </span>
            <a href={resumeUrl} download="NguyenTung_AI_Resume.pdf">download it</a>.
          </div>
        </object>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .resume-page {
    min-height: calc(100dvh - 76px);
    padding: clamp(2.5rem, 4vw, 3.5rem) 1.5rem clamp(4rem, 7vw, 6rem);
    background: var(--ivory-light);
  }

  .resume-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    padding-bottom: clamp(1.75rem, 3vw, 2.5rem);
    align-items: end;
    border-bottom: 1px solid var(--stone);
  }

  .resume-kicker {
    margin: 0 0 1rem;
    color: var(--cloud-dark);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--slate-dark);
    font-family: var(--font-sans);
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 600;
    letter-spacing: -0.065em;
    line-height: 0.93;
  }

  h1 em {
    font-family: var(--font-serif);
    font-weight: 400;
  }

  .resume-summary {
    max-width: 650px;
    margin: 1.5rem 0 0;
    color: var(--slate-medium);
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    line-height: 1.5;
  }

  .resume-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .resume-open {
    display: inline-flex;
    padding-bottom: 0.25rem;
    align-items: center;
    gap: 0.55rem;
    border-bottom: 1px solid var(--slate-dark);
    color: var(--slate-dark);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .resume-open:hover {
    border-color: var(--clay-deep);
    color: var(--clay-deep);
  }

  .resume-download {
    gap: 1rem;
  }

  .resume-viewer {
    height: clamp(620px, calc(100dvh - 250px), 980px);
    margin-top: clamp(1.5rem, 3vw, 2rem);
    overflow: hidden;
    border: 1px solid var(--stone);
    background: #525659;
  }

  .resume-viewer object {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .resume-fallback {
    padding: 3rem;
    background: var(--ivory-medium);
    color: var(--slate-dark);
    font-family: var(--font-serif);
    text-align: center;
  }

  .resume-fallback a {
    font-family: var(--font-sans);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .resume-page {
      padding: 3rem 0.75rem 4rem;
    }

    .resume-header {
      grid-template-columns: 1fr;
      align-items: start;
    }

    h1 {
      font-size: clamp(2.75rem, 13vw, 4rem);
    }

    .resume-actions {
      width: 100%;
      justify-content: space-between;
    }

    .resume-viewer {
      height: 75dvh;
      min-height: 520px;
    }
  }

  @media (max-width: 380px) {
    .resume-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .resume-open {
      align-self: flex-start;
    }

    .resume-download {
      width: 100%;
    }
  }
</style>
