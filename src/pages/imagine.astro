---
import Navbar from "../components/Navbar.astro";
import PlaygroundFrame from "../components/PlaygroundFrame.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const imagineUrl = "https://7863--main--frontier--idp-lab.coder.vts-ai.space/";
---

<BaseLayout
  title="Imagine"
  description="Explore and interact with Imagine, directly from TONVERSE."
>
  <Navbar active="playground" playgroundApp="imagine" />
  <PlaygroundFrame
    name="Imagine"
    url={imagineUrl}
    description="AI image generation playground"
    permissions="camera; microphone; clipboard-read; clipboard-write; fullscreen"
    showToolbar={false}
  />
</BaseLayout>
