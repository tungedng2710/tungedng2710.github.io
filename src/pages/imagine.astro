---
import Navbar from "../components/Navbar.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const imagineUrl = "https://7863--main--frontier--idp-lab.coder.vts-ai.space/";
---

<BaseLayout
  title="Imagine"
  description="Explore and interact with Imagine, directly from TONVERSE."
>
  <Navbar active="imagine" />
  <main class="imagine-page">
    <div class="imagine-frame-wrap" data-imagine-frame>
      <div class="imagine-loading" role="status">
        <span class="imagine-loading__spinner" aria-hidden="true"></span>
        <span>Loading Imagine…</span>
      </div>
      <iframe
        class="imagine-frame"
        src={imagineUrl}
        title="Imagine interactive application"
        allow="camera; microphone; clipboard-read; clipboard-write; fullscreen"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>
  </main>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>("[data-imagine-frame]").forEach((wrapper) => {
    const frame = wrapper.querySelector<HTMLIFrameElement>("iframe");
    frame?.addEventListener("load", () => wrapper.classList.add("is-loaded"));
  });
</script>

<style>
  .imagine-page {
    display: flex;
    height: calc(100dvh - 76px);
    min-height: 520px;
    overflow: hidden;
    flex-direction: column;
    background: var(--ivory-medium);
  }

  .imagine-frame-wrap {
    position: relative;
    min-height: 0;
    flex: 1;
    background: var(--ivory-light);
  }

  .imagine-frame {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .imagine-frame-wrap.is-loaded .imagine-frame {
    opacity: 1;
  }

  .imagine-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    color: var(--cloud-dark);
    font-size: 0.72rem;
  }

  .imagine-loading__spinner {
    width: 18px;
    height: 18px;
    border: 2px solid var(--stone);
    border-top-color: var(--clay-deep);
    border-radius: 50%;
    animation: imagine-spin 0.75s linear infinite;
  }

  @keyframes imagine-spin {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .imagine-loading__spinner {
      animation: none;
    }
  }
</style>
