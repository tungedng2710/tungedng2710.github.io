---
import Navbar from "../components/Navbar.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const imagineUrl = "https://7863--main--frontier--idp-lab.coder.vts-ai.space/";
---

<BaseLayout
  title="Imagine"
  description="Explore and interact with Imagine, directly from TONVERSE."
>
  <Navbar active="imagine" />
  <main class="imagine-page">
    <div class="imagine-frame-wrap">
      <iframe
        class="imagine-frame"
        src={imagineUrl}
        title="Imagine interactive application"
        allow="camera; microphone; clipboard-read; clipboard-write; fullscreen"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>
  </main>
</BaseLayout>

<style>
  .imagine-page {
    display: flex;
    height: calc(100dvh - 76px);
    min-height: 520px;
    overflow: hidden;
    flex-direction: column;
    background: var(--ivory-medium);
  }

  .imagine-frame-wrap {
    min-height: 0;
    flex: 1;
    background: var(--ivory-light);
  }

  .imagine-frame {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
  }
</style>
