---
import Navbar from "../components/Navbar.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const imagineUrl = "https://7863--main--frontier--idp-lab.coder.vts-ai.space/";
---

<BaseLayout
  title="Imagine"
  description="Explore and interact with Imagine, directly from TONVERSE."
>
  <Navbar active="imagine" />
  <main class="imagine-page">
    <header class="imagine-toolbar">
      <div class="imagine-toolbar__copy">
        <span class="imagine-status" aria-hidden="true"></span>
        <div>
          <h1>Imagine</h1>
          <p>An interactive AI playground</p>
        </div>
      </div>
      <a class="imagine-external" href={imagineUrl} target="_blank" rel="noreferrer">
        Open in new tab
        <span aria-hidden="true">↗</span>
      </a>
    </header>

    <div class="imagine-frame-wrap" data-imagine-frame>
      <div class="imagine-loading" role="status">
        <span class="imagine-loading__spinner" aria-hidden="true"></span>
        <span>Loading Imagine…</span>
      </div>
      <iframe
        class="imagine-frame"
        src={imagineUrl}
        title="Imagine interactive application"
        allow="camera; microphone; clipboard-read; clipboard-write; fullscreen"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>
  </main>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>("[data-imagine-frame]").forEach((wrapper) => {
    const frame = wrapper.querySelector<HTMLIFrameElement>("iframe");
    frame?.addEventListener("load", () => wrapper.classList.add("is-loaded"));
  });
</script>

<style>
  .imagine-page {
    display: flex;
    height: calc(100dvh - 76px);
    min-height: 520px;
    overflow: hidden;
    flex-direction: column;
    background: var(--ivory-medium);
  }

  .imagine-toolbar {
    display: flex;
    min-height: 68px;
    padding: 0 1.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--stone);
  }

  .imagine-toolbar__copy {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .imagine-status {
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #4f9c6b;
    box-shadow: 0 0 0 4px color-mix(in srgb, #4f9c6b 15%, transparent);
  }

  .imagine-toolbar h1,
  .imagine-toolbar p {
    margin: 0;
  }

  .imagine-toolbar h1 {
    color: var(--slate-dark);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.1;
  }

  .imagine-toolbar p {
    margin-top: 0.12rem;
    color: var(--cloud-dark);
    font-size: 0.65rem;
  }

  .imagine-external {
    display: inline-flex;
    min-height: 38px;
    padding: 0 0.9rem;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid var(--stone);
    border-radius: 8px;
    color: var(--slate-medium);
    font-size: 0.68rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }

  .imagine-external:hover {
    border-color: var(--slate-dark);
    background: var(--ivory-light);
    color: var(--slate-dark);
  }

  .imagine-frame-wrap {
    position: relative;
    min-height: 0;
    flex: 1;
    background: var(--ivory-light);
  }

  .imagine-frame {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .imagine-frame-wrap.is-loaded .imagine-frame {
    opacity: 1;
  }

  .imagine-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    color: var(--cloud-dark);
    font-size: 0.72rem;
  }

  .imagine-loading__spinner {
    width: 18px;
    height: 18px;
    border: 2px solid var(--stone);
    border-top-color: var(--clay-deep);
    border-radius: 50%;
    animation: imagine-spin 0.75s linear infinite;
  }

  @keyframes imagine-spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 700px) {
    .imagine-toolbar {
      min-height: 60px;
      padding: 0 0.75rem;
    }

    .imagine-toolbar p {
      display: none;
    }

    .imagine-external {
      padding: 0 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .imagine-loading__spinner {
      animation: none;
    }
  }
</style>
