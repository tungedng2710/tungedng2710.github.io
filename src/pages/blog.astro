---
import { getCollection } from "astro:content";
import BlogListing from "../components/BlogListing.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { POSTS_PER_PAGE, primaryPosts } from "../utils/posts";

const allPosts = primaryPosts(
  (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  ),
);
const posts = allPosts.slice(0, POSTS_PER_PAGE);
const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);
---

<BaseLayout title="Blog" description="Research notes and engineering essays on AI, mathematics, and software systems.">
  <Navbar active="blog" />
  <main>
    <BlogListing
      posts={posts}
      totalPosts={allPosts.length}
      currentPage={1}
      totalPages={totalPages}
    />
  </main>
  <Footer />
</BaseLayout>
