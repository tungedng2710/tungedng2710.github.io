---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Footer from "../../components/Footer.astro";
import Navbar from "../../components/Navbar.astro";
import { withBase } from "../../config";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, postSlug, postUrl, readTime } from "../../utils/posts";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: {
      post,
      translations: post.data.translationKey
        ? posts
            .filter((candidate) => candidate.data.translationKey === post.data.translationKey)
            .sort((a, b) => a.data.lang.localeCompare(b.data.lang))
        : [post],
    },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
  translations: CollectionEntry<"blog">[];
}

const { post, translations } = Astro.props;
const { Content, headings } = await render(post);
const image = post.data.image.startsWith("/") ? withBase(post.data.image) : post.data.image;
const isVietnamese = post.data.lang === "vi";
const tableOfContents = headings.filter(
  (heading) =>
    heading.depth <= 3 &&
    !["table of contents", "mục lục"].includes(heading.text.trim().toLocaleLowerCase()),
);
const tocItems =
  tableOfContents.length > 0
    ? tableOfContents
    : [{ depth: 1, slug: "post", text: post.data.title }];
const languageNames: Record<string, { code: string; name: string }> = {
  en: { code: "EN", name: "English" },
  vi: { code: "VI", name: "Tiếng Việt" },
};
const copy = isVietnamese
  ? {
      language: "Ngôn ngữ",
      published: "Đăng ngày",
      by: "bởi",
      read: "phút đọc",
      contents: "Trong bài viết",
      hideContents: "Ẩn mục lục",
      showContents: "Hiện mục lục",
    }
  : {
      language: "Language",
      published: "Published on",
      by: "by",
      read: "min read",
      contents: "On this page",
      hideContents: "Hide contents",
      showContents: "Show contents",
    };
const alternates = translations.map((translation) => ({
  lang: translation.data.lang,
  href: withBase(postUrl(translation)),
}));
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={image}
  lang={post.data.lang}
  type="article"
  alternates={translations.length > 1 ? alternates : []}
>
  <Navbar active="blog" />
  <main>
    <article class="hero" id="post">
      <div class="hero-body">
        <div class="container">
          <header
            class:list={["post-header", { "has-translations": translations.length > 1 }]}
            data-reveal
          >
            {
              translations.length > 1 && (
                <nav class="language-switcher" aria-label={copy.language}>
                  <span class="language-switcher__label">
                    <i class="fas fa-globe" aria-hidden="true" />
                    <span>{copy.language}</span>
                  </span>
                  <div class="language-switcher__options">
                    {translations.map((translation) => {
                      const language = languageNames[translation.data.lang] ?? {
                        code: translation.data.lang.toUpperCase(),
                        name: translation.data.lang,
                      };
                      const className = `language-switcher__option${
                        translation.id === post.id ? " is-active" : ""
                      }`;

                      return translation.id === post.id ? (
                        <span class={className} aria-current="page">
                          <strong>{language.code}</strong>
                          <span class="is-sr-only">{language.name}</span>
                        </span>
                      ) : (
                        <a
                          class={className}
                          href={withBase(postUrl(translation))}
                          hreflang={translation.data.lang}
                          lang={translation.data.lang}
                          aria-label={`${copy.language}: ${language.name}`}
                          title={language.name}
                        >
                          <strong>{language.code}</strong>
                          <span class="is-sr-only">{language.name}</span>
                        </a>
                      );
                    })}
                  </div>
                </nav>
              )
            }
            <h1 class="title is-2 has-text-weight-semibold">{post.data.title}</h1>
            <hr class="has-background-black" />
            <div class="columns is-variable is-5">
              <div class="column is-5">
                <figure class="image is-16by9 has-shadow">
                  <img src={image} alt={post.data.title} id="post-image" />
                </figure>
              </div>
              <div class="subtitle column is-6 has-text-left-desktop has-text-left-tablet has-text-center-mobile">
                <p id="description" class="content is-small has-text-weight-medium is-uppercase">
                  {post.data.description}
                </p>
                <p class="subtitle is-6 is-uppercase has-text-weight-normal has-text-black-ter">
                  {copy.published}{" "}
                  <b>{formatDate(post.data.pubDate, isVietnamese ? "vi-VN" : "en-US")}</b>{" "}
                  {copy.by}{" "}
                  <a href={post.data.authorUrl} target="_blank" rel="noreferrer">
                    <b class="has-text-link"><u>{post.data.authorName}</u></b>
                  </a>
                </p>
                {
                  post.data.tags.length > 0 && (
                    <p class="subtitle is-uppercase">
                      <i class="fas fa-tags" />{" "}
                      {post.data.tags.map((tag) => <span class="tag is-link">{tag}</span>)}
                    </p>
                  )
                }
                <p class="subtitle is-uppercase">
                  <i class="fas fa-clock"></i>{" "}
                  <b class="has-text-link">{readTime(post.body)}</b> {copy.read}
                </p>
              </div>
            </div>
          </header>
          <div class="post-layout">
            <div class="post-content content">
              <Content />
            </div>
            <aside class="post-toc" id="post-toc-sidebar" aria-label={copy.contents}>
              <button
                class="post-toc__rail"
                type="button"
                data-toc-trigger
                aria-label={copy.showContents}
                aria-controls="post-toc-navigation"
                aria-expanded="false"
              >
                {
                  tocItems.map((heading) => (
                    <span
                      class={`post-toc__marker is-depth-${heading.depth}`}
                      data-toc-marker={heading.slug}
                      aria-hidden="true"
                    />
                  ))
                }
              </button>
              <div class="post-toc__panel">
                <div class="post-toc__header">
                  <p class="post-toc__title">
                    <i class="fas fa-list-ul" aria-hidden="true" />
                    {copy.contents}
                  </p>
                </div>
                <nav class="post-toc__nav" id="post-toc-navigation">
                  {
                    tocItems.map((heading) => (
                      <a
                        class={`post-toc__link is-depth-${heading.depth}`}
                        href={`#${heading.slug}`}
                        data-toc-link={heading.slug}
                      >
                        {heading.text}
                      </a>
                    ))
                  }
                </nav>
              </div>
            </aside>
          </div>
        </div>
      </div>
    </article>
  </main>
  <Footer />
  <script>
    const tocLinks = [
      ...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
    ];
    const tocMarkers = [
      ...document.querySelectorAll<HTMLElement>("[data-toc-marker]"),
    ];
    const observedHeadings = tocLinks
      .map((link) => document.getElementById(link.dataset.tocLink ?? ""))
      .filter((heading): heading is HTMLElement => Boolean(heading));

    if (tocLinks.length > 0 && observedHeadings.length > 0 && "IntersectionObserver" in window) {
      const activateLink = (id: string) => {
        tocLinks.forEach((link) => {
          const isActive = link.dataset.tocLink === id;
          link.classList.toggle("is-active", isActive);
          if (isActive) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        });
        tocMarkers.forEach((marker) => {
          marker.classList.toggle("is-active", marker.dataset.tocMarker === id);
        });
      };

      const visibleHeadings = new Map<string, number>();
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              visibleHeadings.set(entry.target.id, entry.boundingClientRect.top);
            } else {
              visibleHeadings.delete(entry.target.id);
            }
          });

          const active = [...visibleHeadings.entries()].sort((a, b) => a[1] - b[1])[0];
          if (active) activateLink(active[0]);
        },
        { rootMargin: "-90px 0px -72% 0px" },
      );

      observedHeadings.forEach((heading) => observer.observe(heading));
      activateLink(observedHeadings[0].id);
    }

    const isVietnamesePost = document.documentElement.lang === "vi";
    const copyLabel = isVietnamesePost ? "Sao chép" : "Copy";
    const copiedLabel = isVietnamesePost ? "Đã sao chép" : "Copied";

    const tocSidebar = document.querySelector<HTMLElement>("#post-toc-sidebar");
    const tocTrigger = document.querySelector<HTMLButtonElement>("[data-toc-trigger]");
    const setTocExpanded = (expanded: boolean) => {
      tocSidebar?.classList.toggle("is-open", expanded);
      tocTrigger?.setAttribute("aria-expanded", String(expanded));
    };

    tocSidebar?.addEventListener("pointerenter", () => setTocExpanded(true));
    tocSidebar?.addEventListener("pointerleave", () => setTocExpanded(false));
    tocSidebar?.addEventListener("focusin", () => setTocExpanded(true));
    tocSidebar?.addEventListener("focusout", (event) => {
      if (!tocSidebar.contains(event.relatedTarget as Node | null)) setTocExpanded(false);
    });

    const mermaidCodeBlocks = [
      ...document.querySelectorAll<HTMLElement>(
        '.post-content pre[data-language="mermaid"] code',
      ),
    ];

    if (mermaidCodeBlocks.length > 0) {
      const renderMermaidDiagrams = async () => {
        const mermaidModuleUrl =
          "https://cdn.jsdelivr.net/npm/mermaid@11.16.0/dist/mermaid.esm.min.mjs";
        const mermaidModule = await import(/* @vite-ignore */ mermaidModuleUrl);
        const mermaid = mermaidModule.default;

        const mermaidDiagrams = mermaidCodeBlocks.flatMap((codeBlock) => {
          const pre = codeBlock.closest("pre");
          if (!pre) return [];

          const diagram = document.createElement("div");
          diagram.className = "mermaid mermaid-diagram";
          diagram.textContent = codeBlock.textContent ?? "";
          diagram.setAttribute("role", "img");
          diagram.setAttribute(
            "aria-label",
            isVietnamesePost ? "Sơ đồ kiến trúc tham chiếu" : "Reference architecture diagram",
          );
          pre.replaceWith(diagram);
          return [diagram];
        });

        mermaid.initialize({
          startOnLoad: false,
          securityLevel: "strict",
          theme: "base",
          flowchart: {
            useMaxWidth: true,
            htmlLabels: true,
            curve: "basis",
          },
          themeVariables: {
            background: "#f0eee6",
            primaryColor: "#f5e3c7",
            primaryTextColor: "#141413",
            primaryBorderColor: "#87867f",
            secondaryColor: "#e3dacc",
            tertiaryColor: "#faf9f5",
            lineColor: "#3d3d3a",
            fontFamily: "Inter, system-ui, sans-serif",
            fontSize: "15px",
          },
        });

        await mermaid.run({ nodes: mermaidDiagrams });

        mermaidDiagrams.forEach((diagram) => {
          const svg = diagram.querySelector<SVGSVGElement>("svg");
          if (!svg) return;

          const viewer = document.createElement("div");
          viewer.className = "mermaid-viewer";

          const viewport = document.createElement("div");
          viewport.className = "mermaid-viewport";
          viewport.tabIndex = 0;
          viewport.setAttribute(
            "aria-label",
            isVietnamesePost
              ? "Sơ đồ tương tác. Dùng các nút để thu phóng và kéo để di chuyển."
              : "Interactive diagram. Use the controls to zoom and drag to pan.",
          );

          const controls = document.createElement("div");
          controls.className = "mermaid-controls";
          controls.setAttribute(
            "aria-label",
            isVietnamesePost ? "Điều khiển sơ đồ" : "Diagram controls",
          );

          const createControl = (action: string, label: string, symbol: string) => {
            const button = document.createElement("button");
            button.type = "button";
            button.className = "mermaid-control";
            button.dataset.mermaidAction = action;
            button.setAttribute("aria-label", label);
            button.title = label;
            button.textContent = symbol;
            controls.appendChild(button);
            return button;
          };

          const zoomIn = createControl(
            "zoom-in",
            isVietnamesePost ? "Phóng to" : "Zoom in",
            "+",
          );
          const zoomOut = createControl(
            "zoom-out",
            isVietnamesePost ? "Thu nhỏ" : "Zoom out",
            "−",
          );
          const reset = createControl(
            "reset",
            isVietnamesePost ? "Đặt lại chế độ xem" : "Reset view",
            "↺",
          );

          const status = document.createElement("span");
          status.className = "is-sr-only";
          status.setAttribute("aria-live", "polite");
          controls.appendChild(status);

          diagram.replaceWith(viewer);
          viewport.appendChild(diagram);
          viewer.append(viewport, controls);

          const minScale = 1;
          const maxScale = 3;
          const scaleStep = 0.25;
          let scale = 1;
          let offsetX = 0;
          let offsetY = 0;
          let dragging = false;
          let pointerStartX = 0;
          let pointerStartY = 0;
          let offsetStartX = 0;
          let offsetStartY = 0;

          const updateView = () => {
            if (scale === 1) {
              offsetX = 0;
              offsetY = 0;
            }
            svg.style.transform = `translate(${offsetX}px, ${offsetY}px) scale(${scale})`;
            viewport.classList.toggle("is-zoomed", scale > 1);
            zoomIn.disabled = scale >= maxScale;
            zoomOut.disabled = scale <= minScale;
            reset.disabled = scale === 1 && offsetX === 0 && offsetY === 0;
            status.textContent = `${Math.round(scale * 100)}%`;
          };

          const setScale = (nextScale: number) => {
            scale = Math.min(maxScale, Math.max(minScale, nextScale));
            updateView();
          };

          zoomIn.addEventListener("click", () => setScale(scale + scaleStep));
          zoomOut.addEventListener("click", () => setScale(scale - scaleStep));
          reset.addEventListener("click", () => {
            scale = 1;
            offsetX = 0;
            offsetY = 0;
            updateView();
          });

          viewport.addEventListener(
            "wheel",
            (event) => {
              if (!event.ctrlKey && !event.metaKey) return;
              event.preventDefault();
              setScale(scale + (event.deltaY < 0 ? scaleStep : -scaleStep));
            },
            { passive: false },
          );

          viewport.addEventListener("pointerdown", (event) => {
            if (scale <= 1) return;
            dragging = true;
            pointerStartX = event.clientX;
            pointerStartY = event.clientY;
            offsetStartX = offsetX;
            offsetStartY = offsetY;
            viewport.setPointerCapture(event.pointerId);
            viewport.classList.add("is-dragging");
          });

          viewport.addEventListener("pointermove", (event) => {
            if (!dragging) return;
            offsetX = offsetStartX + event.clientX - pointerStartX;
            offsetY = offsetStartY + event.clientY - pointerStartY;
            updateView();
          });

          const stopDragging = (event: PointerEvent) => {
            if (!dragging) return;
            dragging = false;
            viewport.releasePointerCapture(event.pointerId);
            viewport.classList.remove("is-dragging");
          };
          viewport.addEventListener("pointerup", stopDragging);
          viewport.addEventListener("pointercancel", stopDragging);

          viewport.addEventListener("keydown", (event) => {
            const panStep = 24;
            if (event.key === "+" || event.key === "=") setScale(scale + scaleStep);
            else if (event.key === "-") setScale(scale - scaleStep);
            else if (event.key === "0") {
              scale = 1;
              offsetX = 0;
              offsetY = 0;
              updateView();
            } else if (scale > 1 && event.key === "ArrowLeft") offsetX += panStep;
            else if (scale > 1 && event.key === "ArrowRight") offsetX -= panStep;
            else if (scale > 1 && event.key === "ArrowUp") offsetY += panStep;
            else if (scale > 1 && event.key === "ArrowDown") offsetY -= panStep;
            else return;

            event.preventDefault();
            updateView();
          });

          updateView();
        });
      };

      void renderMermaidDiagrams();
    }

    const writeToClipboard = async (text: string) => {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
        return;
      }

      const textarea = document.createElement("textarea");
      textarea.value = text;
      textarea.setAttribute("readonly", "");
      textarea.style.position = "fixed";
      textarea.style.opacity = "0";
      document.body.appendChild(textarea);
      textarea.select();
      const legacyDocument = document as unknown as {
        execCommand: (command: string) => boolean;
      };
      legacyDocument.execCommand("copy");
      textarea.remove();
    };

    document.querySelectorAll<HTMLPreElement>(".post-content pre").forEach((pre) => {
      if (pre.dataset.language === "mermaid") return;

      const wrapper = document.createElement("div");
      wrapper.className = "code-block";

      const button = document.createElement("button");
      button.className = "code-copy-button";
      button.type = "button";
      button.textContent = copyLabel;
      button.setAttribute("aria-label", `${copyLabel} code`);
      button.setAttribute("aria-live", "polite");

      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.append(pre, button);

      button.addEventListener("click", async () => {
        const code = pre.querySelector("code")?.innerText ?? pre.innerText;

        try {
          await writeToClipboard(code);
          button.textContent = copiedLabel;
          button.classList.add("is-copied");
          button.setAttribute("aria-label", copiedLabel);

          window.setTimeout(() => {
            button.textContent = copyLabel;
            button.classList.remove("is-copied");
            button.setAttribute("aria-label", `${copyLabel} code`);
          }, 1800);
        } catch {
          button.textContent = copyLabel;
        }
      });
    });
  </script>
</BaseLayout>
