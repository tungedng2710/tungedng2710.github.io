---
import { getCollection } from "astro:content";
import BlogListing from "../../../components/BlogListing.astro";
import Footer from "../../../components/Footer.astro";
import Navbar from "../../../components/Navbar.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  POSTS_PER_PAGE,
  primaryPosts,
  type BlogPost,
} from "../../../utils/posts";

export async function getStaticPaths() {
  const allPosts = primaryPosts(
    (await getCollection("blog")).sort(
      (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
    ),
  );
  const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const currentPage = index + 2;
    const start = (currentPage - 1) * POSTS_PER_PAGE;

    return {
      params: { page: String(currentPage) },
      props: {
        posts: allPosts.slice(start, start + POSTS_PER_PAGE),
        totalPosts: allPosts.length,
        currentPage,
        totalPages,
      },
    };
  });
}

interface Props {
  posts: BlogPost[];
  totalPosts: number;
  currentPage: number;
  totalPages: number;
}

const { posts, totalPosts, currentPage, totalPages } = Astro.props;
---

<BaseLayout
  title={`Blog — Page ${currentPage}`}
  description="Research notes and engineering essays on AI, mathematics, and software systems."
>
  <Navbar active="blog" />
  <main>
    <BlogListing
      posts={posts}
      totalPosts={totalPosts}
      currentPage={currentPage}
      totalPages={totalPages}
    />
  </main>
  <Footer />
</BaseLayout>
