---
import { withBase } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404" description="The requested page could not be found.">
  <main>
    <section class="hero is-fullheight has-text-centered" id="not-found">
      <div class="hero-body">
        <div class="container" data-reveal>
          <p class="section-kicker">Field note missing</p>
          <h1 class="title is-1">404</h1>
          <p>The page you’re trying to load was not found.</p>
          <hr />
          <a
            href={withBase("/")}
            class="button button-primary"
          >
            Return home ↗
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
