---
import { site, withBase } from "../config";

const authorImage = site.author.image.startsWith("/")
  ? withBase(site.author.image)
  : site.author.image;
---

<section class="hero" id="about">
  <div class="hero-body">
    <div class="container">
      <div class="about-heading" data-reveal>
        <p class="section-kicker">About</p>
        <h2>Research-minded.<br /><em>Product-focused.</em></h2>
      </div>
      <div class="columns is-vcentered about-grid">
        <div class="column is-one-third-desktop is-one-third-tablet" data-reveal>
          <div class="profile-frame">
            <figure class="image">
              <img src={authorImage} alt={site.author.name} />
            </figure>
          </div>
          <div class="profile-caption">
            <span>Portrait / 2026</span>
            <span>Vietnam · Working globally</span>
          </div>
        </div>
        <div
          class="column has-text-left-desktop has-text-left-tablet has-text-left-fullhd"
          data-reveal
          style="--reveal-delay: 100ms;"
        >
          <div class="about-card">
            <p class="about-label">Profile — Tung Nguyen</p>
            <p>{site.author.about}</p>
            <div class="about-actions">
              <a
                href={`mailto:${site.email}`}
                class="button button-primary"
              >
                Email me ↗
              </a>
              <a
                href={withBase("/project")}
                class="button button-secondary"
              >
                Projects
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="columns is-centered contact-strip" data-reveal>
        <div class="column is-three-quarters">
          <p class="contact-kicker">Open to conversations</p>
          <h3>Have an interesting problem?<br /><em>Let’s make it legible.</em></h3>
          <div class="is-size-2 social-links">
            <a href={`mailto:${site.email}`} aria-label="Email">
              <i class="fas fa-envelope"></i>
            </a>
            <a href={site.social.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">
              <i class="fab fa-linkedin"></i>
            </a>
            <a href={site.social.github} target="_blank" rel="noreferrer" aria-label="GitHub">
              <i class="fab fa-github"></i>
            </a>
            <a href={site.social.youtube} target="_blank" rel="noreferrer" aria-label="YouTube">
              <i class="fab fa-youtube"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .profile-frame {
    position: relative;
    max-width: 390px;
    margin: 0;
    padding: 0;
    border: 1px solid var(--stone);
    border-radius: 24px;
    background: var(--manilla);
  }

  .profile-frame .image {
    margin: 0;
  }

  .profile-frame img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
    border: 0 !important;
    border-radius: 23px;
    filter: saturate(0.72) sepia(0.08);
  }

  .about-card {
    padding: clamp(1.75rem, 5vw, 4.5rem);
    border: 1px solid var(--slate-dark);
    border-radius: 24px;
    background: var(--ivory-light);
  }

  .about-card > p {
    color: var(--slate-dark) !important;
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.55;
    text-align: left;
  }

  .about-card .about-label {
    margin-bottom: 2rem;
    color: var(--cloud-dark) !important;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .profile-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.55rem;
    max-width: 390px;
    margin-top: 0.75rem;
    color: var(--cloud-dark);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .contact-strip {
    margin-top: clamp(4rem, 8vw, 7rem) !important;
    padding: clamp(2.5rem, 7vw, 5.5rem);
    border: 1px solid var(--stone);
    border-radius: 24px;
    background: var(--oat-warm);
  }

  .contact-kicker {
    margin-bottom: 1rem;
    color: var(--cloud-dark) !important;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    margin-bottom: 2rem;
    color: var(--slate-dark);
    font-family: var(--font-sans);
    font-size: clamp(2rem, 5vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.02;
  }

  h3 em {
    font-family: var(--font-serif);
    font-weight: 400;
  }

  .social-links {
    margin-top: 1rem;
  }

  .social-links a {
    display: inline-grid;
    width: 48px;
    height: 48px;
    min-width: 0 !important;
    margin: 0 0.3rem !important;
    place-items: center;
    border: 1px solid var(--slate-dark);
    border-radius: 10px;
    background: transparent;
    color: var(--slate-dark);
    font-size: 1rem;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .social-links a:hover {
    background: var(--slate-dark);
    color: var(--ivory-light);
  }

  @media (max-width: 768px) {
    .profile-frame,
    .profile-caption {
      max-width: 100%;
    }
  }
</style>
