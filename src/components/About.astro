---
import { site, withBase } from "../config";

const authorImage = site.author.image.startsWith("/")
  ? withBase(site.author.image)
  : site.author.image;
---

<section class="hero" id="about">
  <div class="hero-body">
    <div class="container">
      <header class="about-heading" data-reveal>
        <p class="section-kicker">About</p>
        <h2>Research-minded. <em>Product-focused.</em></h2>
      </header>

      <div class="about-profile">
        <div class="profile-block" data-reveal>
          <div class="profile-frame">
            <figure class="image">
              <img src={authorImage} alt={site.author.name} />
            </figure>
          </div>
          <div class="profile-caption">
            <span>Portrait / 2026</span>
            <span>Vietnam · Working globally</span>
          </div>
        </div>
        <div class="about-copy" data-reveal style="--reveal-delay: 100ms;">
          <p class="about-label">Profile — Tung Nguyen</p>
          <p class="about-bio">{site.author.about}</p>
          <nav class="about-actions" aria-label="Profile links">
            <a href={`mailto:${site.email}`}>Email me <span aria-hidden="true">↗</span></a>
            <a href={withBase("/project")}>View projects <span aria-hidden="true">→</span></a>
            <a href={withBase("/resume")}>View resume <span aria-hidden="true">→</span></a>
          </nav>
        </div>
      </div>

      <div class="contact-strip" data-reveal>
        <div class="contact-message">
          <p class="contact-kicker">Open to conversations</p>
          <h3>Have an interesting problem?<br /><em>Let’s make it legible.</em></h3>
        </div>
        <nav class="social-links" aria-label="Social links">
            <a href={`mailto:${site.email}`}>
              <i class="fas fa-envelope"></i>
              <span>Email</span>
            </a>
            <a href={site.social.linkedin} target="_blank" rel="noreferrer">
              <i class="fab fa-linkedin"></i>
              <span>LinkedIn</span>
            </a>
            <a href={site.social.github} target="_blank" rel="noreferrer">
              <i class="fab fa-github"></i>
              <span>GitHub</span>
            </a>
            <a href={site.social.youtube} target="_blank" rel="noreferrer">
              <i class="fab fa-youtube"></i>
              <span>YouTube</span>
            </a>
        </nav>
      </div>
    </div>
  </div>
</section>

<style>
  .about-profile {
    display: grid;
    grid-template-columns: minmax(190px, 230px) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: stretch;
  }

  .profile-block {
    width: 100%;
  }

  .profile-frame {
    position: relative;
    width: 100%;
    height: 280px;
    margin: 0;
    padding: 0;
    border: 1px solid var(--stone);
    border-radius: 4px;
    background: var(--manilla);
  }

  .profile-frame .image {
    margin: 0;
  }

  .profile-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    display: block;
    border: 0 !important;
    border-radius: 3px;
    filter: saturate(0.72) sepia(0.08);
  }

  .about-copy {
    display: flex;
    min-width: 0;
    min-height: 280px;
    padding: 1.5rem 0;
    flex-direction: column;
    border-top: 1px solid var(--slate-dark);
    border-bottom: 1px solid var(--stone);
  }

  .about-bio {
    max-width: 860px;
    margin: auto 0;
    color: var(--slate-dark) !important;
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.5;
    text-align: left;
  }

  .about-label {
    margin: 0;
    color: var(--cloud-dark) !important;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 1.75rem;
    margin: 0;
  }

  .about-actions a {
    display: inline-flex;
    padding-bottom: 0.25rem;
    align-items: center;
    gap: 0.55rem;
    border-bottom: 1px solid var(--slate-dark);
    color: var(--slate-dark);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .about-actions a:hover {
    color: var(--clay-deep);
    border-color: var(--clay-deep);
  }

  .profile-caption {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 230px;
    margin-top: 0.75rem;
    color: var(--cloud-dark);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .contact-strip {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(240px, 0.75fr);
    gap: clamp(3rem, 8vw, 8rem);
    margin-top: clamp(4rem, 7vw, 6rem);
    padding: clamp(3rem, 5vw, 4.5rem) 0;
    align-items: end;
    border-top: 1px solid var(--stone);
    border-bottom: 1px solid var(--stone);
  }

  .contact-kicker {
    margin-bottom: 1rem;
    color: var(--cloud-dark) !important;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    color: var(--slate-dark);
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 3.75rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.02;
  }

  h3 em {
    font-family: var(--font-serif);
    font-weight: 400;
  }

  .social-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.5rem;
  }

  .social-links a {
    display: flex;
    min-width: 0;
    padding: 0.9rem 0;
    align-items: center;
    gap: 0.65rem;
    border: 0;
    border-top: 1px solid var(--stone);
    border-radius: 0;
    background: transparent;
    color: var(--slate-dark);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .social-links a:hover {
    background: transparent;
    color: var(--clay-deep);
  }

  .social-links i {
    width: 1rem;
    text-align: center;
  }

  @media (max-width: 768px) {
    .about-profile {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .profile-block {
      display: grid;
      grid-template-columns: minmax(150px, 180px) minmax(0, 1fr);
      gap: 1rem;
      align-items: end;
    }

    .profile-frame {
      height: 225px;
    }

    .profile-caption {
      max-width: none;
      margin: 0;
      align-items: flex-start;
      flex-direction: column;
    }

    .about-copy {
      min-height: 0;
      padding: 1.25rem 0;
      gap: 1.5rem;
    }

    .contact-strip {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      margin-top: 3.5rem;
      padding: 2.5rem 0;
    }

    h3 {
      font-size: clamp(2rem, 10vw, 3rem);
    }
  }

  @media (max-width: 380px) {
    .about-actions {
      flex-direction: column;
    }

    .about-actions .button {
      width: 100%;
    }
  }
</style>
