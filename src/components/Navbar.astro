---
import { site, withBase } from "../config";

interface Props {
  active?: "home" | "blog" | "project" | "playground";
  playgroundApp?: "imagine" | "parse-anything";
}

const { active, playgroundApp } = Astro.props;
---

<nav class="navbar is-fixed-top" role="navigation" aria-label="main navigation" id="navbar">
  <div class="container">
    <div class="navbar-brand">
      <a class="navbar-item" href={withBase("/")}>
        <span class="theme-logo" aria-hidden="true">
          <img class="brand-logo theme-logo__light" src={withBase("/assets/images/logo_black.png")} alt="" />
          <img class="brand-logo theme-logo__dark" src={withBase("/assets/images/logo_white.png")} alt="" />
        </span>
        <strong>{site.title}</strong>
      </a>
      <button
        class="navbar-burger"
        type="button"
        aria-label="menu"
        aria-expanded="false"
        aria-controls="navbar-menu"
        data-target="navbar-menu"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>

    <div class="navbar-menu" id="navbar-menu">
      <div class="navbar-end">
        <a class:list={["navbar-item", { "is-active": active === "home" }]} href={withBase("/")}>
          Home
        </a>
        <a class="navbar-item" href={withBase("/#about")}>About</a>
        <a class:list={["navbar-item", { "is-active": active === "blog" }]} href={withBase("/blog")}>
          Writing
        </a>
        <a
          class:list={["navbar-item", { "is-active": active === "project" }]}
          href={withBase("/project")}
        >
          Projects
        </a>
        <div class="playground-menu">
          <a
            class:list={[
              "playground-menu__trigger",
              { "is-active": active === "playground" },
            ]}
            href={withBase("/playground")}
            aria-haspopup="true"
          >
            Playground
            <svg aria-hidden="true" viewBox="0 0 12 12">
              <path d="m3 4.5 3 3 3-3"></path>
            </svg>
          </a>
          <div class="playground-menu__items" aria-label="Playground apps">
            <a
              class:list={["playground-menu__item", { "is-active": playgroundApp === "imagine" }]}
              href={withBase("/imagine")}
            >
              <span>Imagine</span>
              <small>Image generation</small>
            </a>
            <a
              class:list={[
                "playground-menu__item",
                { "is-active": playgroundApp === "parse-anything" },
              ]}
              href={withBase("/parse-anything")}
            >
              <span>ParseAnything</span>
              <small>Document parsing</small>
            </a>
          </div>
        </div>
        <button class="theme-toggle" type="button" aria-label="Switch to dark theme" title="Switch to dark theme">
          <svg class="theme-toggle__sun" aria-hidden="true" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
          </svg>
          <svg class="theme-toggle__moon" aria-hidden="true" viewBox="0 0 24 24">
            <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>

<script>
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");

  const setTheme = (theme: "light" | "dark", save = false) => {
    document.documentElement.dataset.theme = theme;
    themeColor?.setAttribute("content", theme === "dark" ? "#171816" : "#f0eee6");

    document.querySelectorAll<HTMLButtonElement>(".theme-toggle").forEach((toggle) => {
      const nextTheme = theme === "dark" ? "light" : "dark";
      const label = `Switch to ${nextTheme} theme`;
      toggle.setAttribute("aria-label", label);
      toggle.setAttribute("title", label);
    });

    if (save) localStorage.setItem("theme", theme);
  };

  setTheme(document.documentElement.dataset.theme === "dark" ? "dark" : "light");

  document.querySelectorAll<HTMLButtonElement>(".theme-toggle").forEach((toggle) => {
    toggle.addEventListener("click", () => {
      setTheme(document.documentElement.dataset.theme === "dark" ? "light" : "dark", true);
    });
  });

  systemTheme.addEventListener("change", (event) => {
    if (!localStorage.getItem("theme")) setTheme(event.matches ? "dark" : "light");
  });

  document.querySelectorAll<HTMLButtonElement>(".navbar-burger").forEach((burger) => {
    const targetId = burger.dataset.target;
    const target = targetId ? document.getElementById(targetId) : null;

    const setMenuOpen = (open: boolean) => {
      burger.classList.toggle("is-active", open);
      target?.classList.toggle("is-active", open);
      burger.setAttribute("aria-expanded", String(open));
      document.body.classList.toggle("is-menu-open", open);
    };

    burger.addEventListener("click", () => {
      setMenuOpen(burger.getAttribute("aria-expanded") !== "true");
    });

    target?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenuOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setMenuOpen(false);
    });

    window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
      if (event.matches) setMenuOpen(false);
    });
  });
</script>
