---
import { site, withBase } from "../config";

interface Props {
  active?: "home" | "blog" | "project" | "imagine";
}

const { active } = Astro.props;
---

<nav class="navbar is-fixed-top" role="navigation" aria-label="main navigation" id="navbar">
  <div class="container">
    <div class="navbar-brand">
      <a class="navbar-item" href={withBase("/")}>
        <img class="brand-logo" src={withBase("/assets/images/logo.png")} alt={`${site.title} logo`} />
        <strong>{site.title}</strong><span class="brand-dot">/ Journal</span>
      </a>
      <button
        class="navbar-burger"
        type="button"
        aria-label="menu"
        aria-expanded="false"
        aria-controls="navbar-menu"
        data-target="navbar-menu"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>

    <div class="navbar-menu" id="navbar-menu">
      <div class="navbar-end">
        <a class:list={["navbar-item", { "is-active": active === "home" }]} href={withBase("/")}>
          Home
        </a>
        <a class="navbar-item" href={withBase("/#about")}>About</a>
        <a class:list={["navbar-item", { "is-active": active === "blog" }]} href={withBase("/blog")}>
          Writing
        </a>
        <a
          class:list={["navbar-item", { "is-active": active === "project" }]}
          href={withBase("/project")}
        >
          Projects
        </a>
        <a
          class:list={["navbar-item", { "is-active": active === "imagine" }]}
          href={withBase("/imagine")}
        >
          Imagine
        </a>
        <button class="theme-toggle" type="button" aria-label="Switch to dark theme" title="Switch to dark theme">
          <svg class="theme-toggle__sun" aria-hidden="true" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
          </svg>
          <svg class="theme-toggle__moon" aria-hidden="true" viewBox="0 0 24 24">
            <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z"></path>
          </svg>
        </button>
        <a class="navbar-contact" href={`mailto:${site.email}`}>Let’s talk <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</nav>

<script>
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");

  const setTheme = (theme: "light" | "dark", save = false) => {
    document.documentElement.dataset.theme = theme;
    themeColor?.setAttribute("content", theme === "dark" ? "#171816" : "#f0eee6");

    document.querySelectorAll<HTMLButtonElement>(".theme-toggle").forEach((toggle) => {
      const nextTheme = theme === "dark" ? "light" : "dark";
      const label = `Switch to ${nextTheme} theme`;
      toggle.setAttribute("aria-label", label);
      toggle.setAttribute("title", label);
    });

    if (save) localStorage.setItem("theme", theme);
  };

  setTheme(document.documentElement.dataset.theme === "dark" ? "dark" : "light");

  document.querySelectorAll<HTMLButtonElement>(".theme-toggle").forEach((toggle) => {
    toggle.addEventListener("click", () => {
      setTheme(document.documentElement.dataset.theme === "dark" ? "light" : "dark", true);
    });
  });

  systemTheme.addEventListener("change", (event) => {
    if (!localStorage.getItem("theme")) setTheme(event.matches ? "dark" : "light");
  });

  document.querySelectorAll<HTMLButtonElement>(".navbar-burger").forEach((burger) => {
    burger.addEventListener("click", () => {
      const targetId = burger.dataset.target;
      const target = targetId ? document.getElementById(targetId) : null;
      const isOpen = burger.classList.toggle("is-active");
      target?.classList.toggle("is-active", isOpen);
      burger.setAttribute("aria-expanded", String(isOpen));
    });
  });
</script>
